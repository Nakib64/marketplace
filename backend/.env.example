PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace_db?schema=public"

# Redis Config (for OTP 5-min TTL storage)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Authentication & JWT
JWT_SECRET="super-secret-jwt-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID="sandbox_store"
SSLCOMMERZ_STORE_PASSWORD="sandbox_password"
SSLCOMMERZ_IS_SANDBOX=true

# Email / Nodemailer (for OTP verification)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_user"
SMTP_PASS="smtp_pass"
SMTP_FROM="noreply@marketplace.com"
